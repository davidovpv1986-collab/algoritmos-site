{
  "name": "algoritmos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API-сервис сайта «Алгоритмос»: приём заявок и отправка на почту (SMTP)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "nodemailer": "^6.10.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  },
  "overrides": {
    "qs": "^6.15.4"
  }
}
