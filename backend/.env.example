# Порт API-сервера
PORT=4000

# Адрес фронтенда — источник, которому разрешён CORS
# Для нескольких источников перечислите через запятую: https://algorithmos.ru,https://www.algorithmos.ru
FRONTEND_URL=http://localhost:9020

# ─── Почта для заявок (SMTP) ───────────────────────────────
# Примеры: Yandex 360 — smtp.yandex.ru:465; Mail.ru for business — smtp.mail.ru:465
SMTP_HOST=
SMTP_PORT=465
# SMTP_SECURE=true   # 465 → true (SSL), 587 → false (STARTTLS). По умолчанию определяется по порту
SMTP_USER=
SMTP_PASS=

# Куда присылать заявки и от чьего имени отправлять
MAIL_TO=info@algorithmos.ru
# MAIL_FROM=         # по умолчанию равен SMTP_USER

# Адрес сайта — для ссылки в автоответе клиенту
# SITE_URL=https://algorithmos.ru

# Пока SMTP не настроен, заявки не теряются:
# сохраняются в backend/data/leads.jsonl
