# Вебхук Bitrix24 для приёма заявок с формы (серверная переменная, не попадает в браузер)
# Формат: https://<portal>.bitrix24.ru/rest/<user>/<key>/crm.lead.add.json
BITRIX_WEBHOOK_URL=

# Публичный базовый URL сайта — для canonical, sitemap и Open Graph
NEXT_PUBLIC_SITE_URL=https://algorithmos.ru

# Номер счётчика Яндекс.Метрики (необязательно; без него аналитика не подключается)
NEXT_PUBLIC_YM_ID=
